{
  "name": "bloodtrail-browser-telemetry-research",
  "version": "0.0.0-research",
  "private": true,
  "type": "module",
  "description": "Research-only FingerprintJS and BotD reproducibility harness. Not a production dependency.",
  "engines": {
    "node": ">=26.5.0"
  },
  "scripts": {
    "lint": "node scripts/check-syntax.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:egress": "node --test tests/egress.test.mjs",
    "test:evidence": "node --test tests/evidence.test.mjs",
    "poc": "node poc/run.mjs",
    "poc:headless": "node poc/run.mjs --skip-headed",
    "evidence:sanitize": "node scripts/sanitize-evidence.mjs",
    "evidence:validate": "node scripts/validate-evidence.mjs evidence/baseline-2026-07-30.sanitized.json",
    "evidence:licenses": "node scripts/generate-license-evidence.mjs evidence/licenses.json",
    "evidence:bundles": "node scripts/measure-bundles.mjs evidence/bundle-sizes.json",
    "evidence:sbom": "npm sbom --omit=optional --sbom-format cyclonedx > evidence/sbom.cdx.json",
    "evidence:audit": "npm audit --json > evidence/npm-audit.json"
  },
  "devDependencies": {
    "@fingerprintjs/botd": "2.0.0",
    "@fingerprintjs/fingerprintjs": "5.2.0",
    "playwright": "1.62.1"
  }
}
