{
  "name": "@bloodtrail/security-audit-sdk-node",
  "version": "0.1.0",
  "description": "Provisional Node.js platform binding for Bloodtrail security audit events",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandohdc/bloodtrail.git",
    "directory": "packages/security-audit-sdk-node"
  },
  "keywords": [
    "audit",
    "security",
    "typescript",
    "nodejs",
    "event-contract",
    "structured-events"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24 <25 || >=26 <27"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "compatibility.json"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:runtime": "tsc -p tsconfig.test.json && node --test dist-tests/**/*.test.js",
    "test": "npm run build && npm run test:runtime",
    "test:dependencies": "node scripts/check-dependencies.mjs",
    "test:package": "node scripts/check-package-contents.mjs",
    "validate": "npm run typecheck && npm run build && npm run test:runtime && npm run test:dependencies && npm run test:package"
  },
  "dependencies": {
    "@bloodtrail/security-audit-sdk-core": "file:../security-audit-sdk-core"
  },
  "devDependencies": {
    "@types/node": "24.2.0",
    "typescript": "5.9.2"
  }
}
