{
  "schema": "bloodtrail.design-pattern-governance.closed-schema",
  "id": "contract-reuse",
  "version": "1.0",
  "supported_versions": ["1.0"],
  "closed": true,
  "note": "Closed Contract Reuse Assessment (CRA) record schema. Two named record shapes, assessment and exemption, selected by the record's explicit mode; no other mode selects a shape. Interpreted by the repository's dependency-free closed-schema interpreter through the CRA-local structural-rule adapter at openspec/scripts/contract-reuse/schema.mjs, which applies only the declared CRA-local relations after the generic field tables. Validation is structural only: it never resolves a mechanism reference against the canonical contract, never reads Git history or governance records, and never establishes that evidence exists. Structural acceptance is not a CRA-validated pass, not signed review, not project-owner approval, and not implementation authorization. The exemption locator names only a change in the fixed packages/security-audit-sdk-core/verification-lifecycle.json governanceRecords[] source; no record-source or record-path field exists, and the adapter never dereferences the locator.",
  "records": {
    "assessment": {
      "closed": true,
      "fields": {
        "schema_version": { "type": "string", "required": true, "enum": ["1.0"] },
        "contract": { "type": "string", "required": true, "enum": ["security-audit@1.0.0"] },
        "mode": { "type": "string", "required": true, "enum": ["assessment"] },
        "disposition": { "type": "string", "required": true, "enum": ["reuse", "extend", "new_contract"] },
        "mechanism_references": {
          "type": "array", "required": false, "min_items": 1, "max_items": 8,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$", "max_length": 200 }
        },
        "compatibility_classification": { "type": "string", "required": false, "enum": ["patch", "minor", "major"] },
        "proposed_contract_id": { "type": "string", "required": false, "min_length": 3, "max_length": 100, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "rationale": { "type": "string", "required": true, "min_length": 40, "max_length": 1000 },
        "trust_boundary": { "type": "string", "required": true, "min_length": 40, "max_length": 1000 },
        "transformation_ownership": { "type": "string", "required": true, "min_length": 40, "max_length": 1000 },
        "alternatives": {
          "type": "array", "required": true, "min_items": 1, "max_items": 2,
          "items": {
            "type": "object", "closed": true,
            "fields": {
              "approach": { "type": "string", "required": true, "enum": ["reuse", "extend", "new_contract"] },
              "rejection_reason": { "type": "string", "required": true, "min_length": 40, "max_length": 1000 }
            }
          }
        },
        "author": {
          "type": "object", "required": true, "closed": true,
          "fields": {
            "name": { "type": "string", "required": true, "min_length": 3, "max_length": 120 },
            "handle": { "type": "string", "required": true, "min_length": 1, "max_length": 39, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?$" }
          }
        },
        "evidence_references": {
          "type": "array", "required": true, "min_items": 1, "max_items": 8,
          "items": { "type": "string", "repository_relative": true }
        },
        "assurance_limitations": {
          "type": "array", "required": true, "min_items": 1, "max_items": 8,
          "items": { "type": "string", "min_length": 20, "max_length": 600 }
        }
      },
      "rules": [
        { "id": "cra-assessment-disposition-fields" },
        { "id": "cra-mechanism-references-unique" },
        { "id": "cra-alternatives-rejected-and-unique" }
      ]
    },
    "exemption": {
      "closed": true,
      "fields": {
        "schema_version": { "type": "string", "required": true, "enum": ["1.0"] },
        "contract": { "type": "string", "required": true, "enum": ["security-audit@1.0.0"] },
        "mode": { "type": "string", "required": true, "enum": ["exemption"] },
        "scope_paths": {
          "type": "array", "required": true, "min_items": 1, "max_items": 25,
          "items": { "type": "string", "repository_relative": true }
        },
        "rationale": { "type": "string", "required": true, "min_length": 40, "max_length": 1000 },
        "governance_locator": {
          "type": "object", "required": true, "closed": true,
          "fields": {
            "change": { "type": "string", "required": true, "pattern": "^[a-z0-9][a-z0-9-]{2,99}$" }
          }
        }
      },
      "rules": []
    }
  }
}
