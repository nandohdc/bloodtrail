{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloodtrail.dev/governance/normative-precedence-pin-set.schema.json",
  "title": "Bloodtrail normative precedence pin set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema", "id", "status", "capability_state_digest", "repository_state",
    "applicability", "overlaps", "debts", "lineage", "created_for"
  ],
  "properties": {
    "$schema": {"type":"string","minLength":1},
    "schema": {"const":"bloodtrail.normative-precedence.pin-set.v1"},
    "id": {"type":"string","pattern":"^[a-z0-9][a-z0-9-]+$"},
    "status": {"enum":["CURRENT","HISTORICAL"]},
    "capability_state_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "repository_state": {
      "type":"object","additionalProperties":false,
      "required":["source","policy","capabilities"],
      "properties":{
        "source":{"$ref":"#/$defs/pathObject"},
        "policy":{"$ref":"#/$defs/pathObject"},
        "authority_registry":{"$ref":"#/$defs/pathObject"},
        "capabilities":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/capabilityObject"}}
      }
    },
    "applicability": {
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["domain","source_sections","owners"],
        "properties":{
          "domain":{"type":"string","minLength":1},
          "source_sections":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
          "owners":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
        }
      }
    },
    "overlaps": {
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["id","domain","capability_objects","classification","rule"],
        "properties":{
          "id":{"type":"string","minLength":1},
          "domain":{"type":"string","minLength":1},
          "capability_objects":{"type":"object"},
          "classification":{"enum":["COMPATIBLE_OVERLAP","DUPLICATE_CONSISTENT","CONTRADICTORY"]},
          "rule":{"type":"string","minLength":1}
        }
      }
    },
    "debts": {
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["id","assertion_id","source_path","source_blob","capability_path","capability_blob","allowed_stages","merge_scope","allowed_merge_path_prefixes","activation_effect","release_effect","recomputed","lineage"],
        "properties":{
          "id":{"type":"string","minLength":1},
          "assertion_id":{"type":"string","minLength":1},
          "source_path":{"type":"string","minLength":1},
          "source_blob":{"type":"string","pattern":"^[0-9a-f]{40}$"},
          "capability_path":{"type":"string","minLength":1},
          "capability_blob":{"type":"string","pattern":"^[0-9a-f]{40}$"},
          "allowed_stages":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
          "merge_scope":{"type":"string","minLength":1},
          "allowed_merge_path_prefixes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
          "activation_effect":{"const":"BLOCK"},
          "release_effect":{"const":"BLOCK"},
          "recomputed":{"type":"boolean"},
          "lineage":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
        }
      }
    },
    "lineage": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "created_for": {
      "type":"object","additionalProperties":false,
      "required":["change_id","lifecycle_state","fold_executed"],
      "properties":{
        "change_id":{"type":"string","minLength":1},
        "lifecycle_state":{"type":"string","minLength":1},
        "fold_executed":{"type":"boolean"}
      }
    },
    "historical_policy_blob": {"type":"string","pattern":"^[0-9a-f]{40}$"}
  },
  "$defs": {
    "pathObject": {
      "type":"object","additionalProperties":false,"required":["path","object"],
      "properties":{"path":{"type":"string","minLength":1},"object":{"type":"string","pattern":"^[0-9a-f]{40}$"}}
    },
    "capabilityObject": {
      "type":"object","additionalProperties":false,"required":["id","path","object"],
      "properties":{"id":{"type":"string","minLength":1},"path":{"type":"string","minLength":1},"object":{"type":"string","pattern":"^[0-9a-f]{40}$"},"domains":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"path_prefixes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"versions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}}
    }
  }
}
